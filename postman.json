{
  "info": {
    "name": "Smart Backend",
    "_postman_id": "f6f0b3a7-8f3a-4e90-a5b7-smart-backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "chatId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Chats",
      "item": [
        {
          "name": "Create Chat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chat created', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('chatId', response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Chat {{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats"
              ]
            }
          }
        },
        {
          "name": "Send Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Message sent', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.content).to.not.be.empty;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Привет {{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats",
                "{{chatId}}",
                "messages"
              ]
            }
          }
        },
        {
          "name": "Get Messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('History loaded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.length).to.be.greaterThan(0);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chats/{{chatId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats",
                "{{chatId}}",
                "messages"
              ]
            }
          }
        },
        {
          "name": "Get Messages Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 returned', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chats/999999/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chats",
                "999999",
                "messages"
              ]
            }
          }
        }
      ]
    }
  ]
}